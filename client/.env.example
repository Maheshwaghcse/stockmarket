# Environment Variables for Vercel Deployment
# Set these in Vercel Project Settings > Environment Variables:

# The live URL of your backend deployed on Render (without trailing slash)
VITE_API_URL=https://stocksense-backend.onrender.com

# Optional (defaults to VITE_API_URL if omitted)
VITE_SOCKET_URL=https://stocksense-backend.onrender.com
